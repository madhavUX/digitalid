# Hostinger / production secrets — copy to .env.production on the VPS only.
# NEVER commit a filled .env.production file.
#
# Shared VPS (1 vCPU / ~4 GB) with WebGuardSphere:
# - Nginx owns :80/:443 — use deploy/nginx.host-snippet.conf (do not edit WG blocks)
# - Host Redis 127.0.0.1:6379 and MySQL :3306 belong to WebGuardSphere — DO NOT use them
# - BookAnything binds only 127.0.0.1:18080 (Django) and 127.0.0.1:13000 (Next.js)

# --- Compose interpolation (postgres/redis) ---
POSTGRES_USER=digitalid
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=digitalid
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
BOOKANYTHING_SITE_DOMAIN=bookanything.in
BOOKANYTHING_WEB_HOST_PORT=18080
BOOKANYTHING_FRONTEND_HOST_PORT=13000
# BookAnything Redis memory cap (Docker Redis only — not host Redis)
BOOKANYTHING_REDIS_MAXMEMORY=96mb
BOOKANYTHING_NODE_OPTIONS=--max-old-space-size=384

# Low-resource defaults (1 vCPU shared VPS) — do not raise without measuring headroom
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
CELERY_CONCURRENCY=1
CELERY_POOL=solo

# Only used if you enable compose profile standalone-edge (NOT beside WebGuardSphere)
SITE_ADDRESS=:80

# --- Django (read by web/worker/beat via env_file) ---
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_40_CHARS
DJANGO_DEBUG=false
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,book.example.com
CSRF_TRUSTED_ORIGINS=https://book.example.com
PUBLIC_APP_URL=https://book.example.com
# Keep short on small Postgres max_connections
DATABASE_CONN_MAX_AGE=30

# DATABASE_URL / REDIS_URL / CELERY_* are injected by docker-compose.production.yml
# to pg.digitalid.internal + BookAnything Docker Redis. Never use 127.0.0.1:6379.

# --- Providers ---
RAZORPAY_PROVIDER=deferred
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_PROVIDER=deferred
WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

GOOGLE_BUSINESS_PROVIDER=deferred
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- External Postgres backups (required for normal ./deploy.sh) ---
# BACKUP_DIR=/var/backups/bookanything
# BACKUP_RETENTION_DAYS=30
# GPG_PASSPHRASE_FILE=/root/.secrets/bookanything-backup-gpg-pass
# EXTERNAL_BACKUP_CMD=rclone copy "$1" remote:bookanything-backups/
# ALERT_CMD=echo
# First empty bootstrap only: ALLOW_DEPLOY_WITHOUT_BACKUP=1 ./deploy.sh
