DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# development | production | test — production enables digitalid.E00x infrastructure checks
DJANGO_ENV=development
# Comma-separated HTTPS origins for CSRF (required when DJANGO_ENV=production)
CSRF_TRUSTED_ORIGINS=

# Local development only. Never commit real credentials.
# Production (Hostinger compose): use host pg.digitalid.internal (see .env.production.example).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/digitalid
# DATABASE_URL=postgres://USER:PASSWORD@pg.digitalid.internal:5432/DBNAME
# Optional pooling/reuse (defaults: 60 when DJANGO_ENV=production, else 0)
# DATABASE_CONN_MAX_AGE=60
# Operator metadata for deploy notes only (not read by the app):
# PRODUCTION_DB_PROVIDER=
# PRODUCTION_DB_REGION=
# PRODUCTION_DB_BACKUP_POLICY=

# Redis (required in production). Leaves LocMem + memory:// Celery when empty in development.
REDIS_URL=
# Optional overrides (default to REDIS_URL when set)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# When DJANGO_DEBUG=false these secure defaults apply; override if needed behind a TLS proxy
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# Public Next.js origin used in WhatsApp manage/book-again links
PUBLIC_APP_URL=http://localhost:3000

# BookAnything public website host (subdomains: {label}.{BOOKANYTHING_SITE_DOMAIN})
BOOKANYTHING_SITE_DOMAIN=bookanything.in

# Google Business Profile foundation (mock for tests/dev; deferred blocks live connect)
GOOGLE_BUSINESS_PROVIDER=deferred
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/businesses/google/callback/
GOOGLE_BUSINESS_SCOPES=https://www.googleapis.com/auth/business.manage
# urlsafe-base64 32-byte key OR any passphrase (SHA-256 derived locally)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Business-owned WhatsApp Business connection (not the platform notification sender)
WHATSAPP_BUSINESS_PROVIDER=deferred
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# WhatsApp transactional notifications
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock

# Approved template names from Meta Business Manager
WHATSAPP_BOOKING_CONFIRMATION_TEMPLATE=
WHATSAPP_BOOKING_CANCELLATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_CONFIRMATION_BODY_FIELDS=business_name,service_name,staff_name,date_label,time_label,public_reference
WHATSAPP_CANCELLATION_BODY_FIELDS=business_name,service_name,date_label,time_label,public_reference
WHATSAPP_CONFIRMATION_URL_BUTTON_INDEX=0
WHATSAPP_CANCELLATION_URL_BUTTON_INDEX=

# Meta WhatsApp Cloud API (backend only — never expose to Next.js)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v21.0

# Automated WhatsApp appointment reminders (management command: send_due_reminders)
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_REMINDER_24H_ENABLED=true
WHATSAPP_REMINDER_1H_ENABLED=true
WHATSAPP_REMINDER_24H_OFFSET_MINUTES=1440
WHATSAPP_REMINDER_1H_OFFSET_MINUTES=60
WHATSAPP_REMINDER_MAX_LATE_MINUTES=30
WHATSAPP_REMINDER_24H_TEMPLATE=
WHATSAPP_REMINDER_1H_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en
WHATSAPP_REMINDER_24H_BODY_FIELDS=business_name,service_name,staff_name,date_label,time_label,public_reference
WHATSAPP_REMINDER_1H_BODY_FIELDS=business_name,service_name,staff_name,time_label,public_reference
WHATSAPP_REMINDER_24H_URL_BUTTON_INDEX=0
WHATSAPP_REMINDER_1H_URL_BUTTON_INDEX=0

MAX_PUBLIC_BOOKING_HISTORY_PAGE_SIZE=50

# Razorpay payments (backend only — never expose secrets to Next.js)
RAZORPAY_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend (Next.js) — see frontend/.env.example
# DJANGO_API_URL=http://127.0.0.1:8000

# Health probes (no auth): GET /health/live/  GET /health/ready/
# Ops: docs/PRODUCTION_RUNBOOK.md  docs/DATABASE_BACKUP_RESTORE.md
# Hostinger production compose: docker-compose.production.yml + .env.production.example
# DB host on VPS must be pg.digitalid.internal (not postgres / localhost) for digitalid.E010
